---
import seasons from '../../data/computed/seasons.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const latestSeason = seasons
  .filter((s) => !s.notStarted)
  .sort((a, b) => b.season.localeCompare(a.season))[0];
const target = `${base}/season/${latestSeason.season}/`;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Redirecting to {latestSeason.season} Season</title>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body>
    <p><a href={target}>Go to the {latestSeason.season} season</a></p>
  </body>
</html>
