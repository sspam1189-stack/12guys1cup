---
import Base from '../layouts/Base.astro';
import MemberLink from '../components/MemberLink.astro';
import seasons from '../../data/computed/seasons.json';

const seasonByYear = Object.fromEntries(seasons.map((s) => [s.season, s]));
const legacyVictims = {
  '2020': '467208097522249728',
  '2019': '596094153587216384',
};

const punishments = [
  {
    year: '2025',
    victim: null,
    punishment: '1000 piece puzzle in a closet with a headlamp',
    status: 'Completed',
  },
  {
    year: '2024',
    victim: null,
    punishment: '30 TikTok challenges/posts',
    status: 'Not completed',
  },
  {
    year: '2023',
    victim: null,
    punishment: 'Live karaoke at the Mavs or Cowboys game before the game starts',
    status: 'Completed',
  },
  {
    year: '2022',
    victim: null,
    punishment: 'Bikini carwash',
    status: 'Completed',
  },
  {
    year: '2021',
    victim: null,
    punishment: '24 hours at Waffle House',
    status: 'Uncompleted. Kicked out of league',
  },
  {
    year: '2020',
    punishment: 'Sports Illustrated bikini photoshoot',
    status: 'Not completed',
  },
  {
    year: '2019',
    punishment: 'Clubbing in a dress',
    status: 'Completed',
  },
];

const isCompleted = (status) => status.toLowerCase() === 'completed';
const statusClass = (status) => {
  if (status.toLowerCase().includes('kicked out')) return 'status-pill warning';
  return isCompleted(status) ? 'status-pill complete' : 'status-pill incomplete';
};
const victimId = (year) => seasonByYear[year]?.lastPlace ?? legacyVictims[year] ?? null;
---
<Base title="Punishments - 12 Guys 1 Cup">
  <h1>Punishments</h1>
  <p class="muted">League punishment history.</p>

  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Year</th><th>Victim</th><th>Punishment</th><th>Status</th></tr>
      </thead>
      <tbody>
        {punishments.map((p) => (
          <tr>
            <td><strong>{p.year}</strong></td>
            <td>{victimId(p.year) ? <MemberLink id={victimId(p.year)} /> : '-'}</td>
            <td>{p.punishment}</td>
            <td>
              <span class={statusClass(p.status)}>
                {p.status}
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
