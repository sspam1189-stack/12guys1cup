---
import Base from '../layouts/Base.astro';
import MemberLink from '../components/MemberLink.astro';
import Legend from '../components/Legend.astro';
import alltime from '../../data/computed/alltime.json';
import members from '../../data/computed/members.json';
import seasons from '../../data/computed/seasons.json';
const latest = seasons.filter((s) => !s.notStarted).map((s) => s.season).sort().at(-1);
const isFormer = (id) => !(members[id]?.seasons ?? []).some((s) => s >= latest);
const pct = (c) => {
  const g = c.wins + c.losses + c.ties;
  return g ? ((c.wins + c.ties / 2) / g).toFixed(3) : '-';
};
const playoffRate = (c) => c.seasons ? c.playoffAppearances / c.seasons : 0;
const playoffDisplay = (c) => c.seasons ? `${c.playoffAppearances} (${Math.round(playoffRate(c) * 100)}%)` : '-';
const record = (c) => `${c.wins}-${c.losses}${c.ties ? `-${c.ties}` : ''}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Only honors actually won get a chip.
const trophies = (c) => [
  c.championships && { icon: '🏆', n: c.championships, kind: 'champ', label: 'Champion' },
  c.runnerUps && { icon: '🥈', n: c.runnerUps, kind: '', label: 'Runner-up' },
  c.thirds && { icon: '🥉', n: c.thirds, kind: '', label: 'Third' },
  c.pfTitles && { icon: '📈', n: c.pfTitles, kind: '', label: 'Most PF' },
  c.lastPlaces && { icon: '💩', n: c.lastPlaces, kind: 'shit', label: 'Shit Bowl' },
].filter(Boolean);
---
<Base title="All-Time Standings - 12 Guys 1 Cup">
  <h1>All-Time Standings</h1>
  <p class="muted">Regular season only. Ranked by win percentage.</p>
  <p class="muted tap-hint">Tap a player for their trophies and stats.</p>
  <Legend class="mobile-only" />

  <ol class="board">
    {alltime.map((c, i) => {
      const diff = c.avgPf - c.avgPa;
      const avatar = members[c.userId]?.avatar;
      return (
        <li>
          <details class="lb-item">
            <summary class="lb-row">
              <span class={`rank-badge ${i === 0 ? 'first' : i === alltime.length - 1 ? 'last' : ''}`}>{i + 1}</span>
              {avatar && <img class="lb-avatar" src={`https://sleepercdn.com/avatars/thumbs/${avatar}`} alt="" width="21" height="21" loading="lazy" />}
              <span class="lb-name">{members[c.userId]?.name ?? c.userId}</span>
              {isFormer(c.userId) && <span class="badge">former</span>}
              <span class="lb-rec">{record(c)}</span>
              <span class="lb-pct">{pct(c)}</span>
              <span class="lb-caret" aria-hidden="true">›</span>
            </summary>
            <div class="lb-detail">
              {trophies(c).length > 0 && (
                <div class="lb-chips">
                  {trophies(c).map((t) => (
                    <span class={`honor-chip ${t.kind}`} title={`${t.label} ×${t.n}`}>
                      {t.icon} <span class="who">×{t.n}</span>
                    </span>
                  ))}
                </div>
              )}
              <div class="lb-grid">
                <div><em>Seasons</em><b>{c.seasons}</b></div>
                <div><em>Playoffs</em><b>{c.seasons ? `${Math.round(playoffRate(c) * 100)}%` : '-'}</b></div>
                <div><em>Avg PF</em><b>{c.avgPf.toFixed(1)}</b></div>
                <div><em>Diff</em><b class={diff >= 0 ? 'green' : 'red'}>{diff >= 0 ? '+' : ''}{diff.toFixed(0)}</b></div>
              </div>
              <a class="lb-profile" href={`${base}/member/${c.userId}/`}>View profile →</a>
            </div>
          </details>
        </li>
      );
    })}
  </ol>

  <div class="table-wrap alltime-table-wrap">
    <table class="sortable alltime-table">
      <thead><tr>
        <th>Member</th><th>Seasons</th><th>W</th><th>L</th><th>T</th><th>Win %</th>
        <th>Avg PF</th><th>Avg PA</th><th>Champ</th><th>2nd</th><th>3rd</th>
        <th>PF Titles</th><th>Playoffs</th><th>LOSER</th>
      </tr></thead>
      <tbody>
        {alltime.map((c) => (
          <tr>
            <td data-label="Member"><MemberLink id={c.userId} avatar={true} />{isFormer(c.userId) && <span class="badge"> former</span>}</td>
            <td data-label="Seasons">{c.seasons}</td>
            <td data-label="W">{c.wins}</td><td data-label="L">{c.losses}</td><td data-label="T">{c.ties}</td>
            <td data-label="Win %" data-v={pct(c)}>{pct(c)}</td>
            <td data-label="Avg PF" data-v={c.avgPf}>{c.avgPf.toFixed(2)}</td>
            <td data-label="Avg PA" data-v={c.avgPa}>{c.avgPa.toFixed(2)}</td>
            <td data-label="Champ">{c.championships || ''}</td><td data-label="2nd">{c.runnerUps || ''}</td><td data-label="3rd">{c.thirds || ''}</td>
            <td data-label="PF Titles">{c.pfTitles || ''}</td>
            <td data-label="Playoffs" data-v={playoffRate(c)}>{playoffDisplay(c)}</td>
            <td data-label="LOSER" class="red">{c.lastPlaces || ''}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <script src="../scripts/sort-tables.js"></script>
</Base>
