---
import members from '../../data/computed/members.json';
const { id, avatar = false, size = 'sm' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const member = members[id];
const name = member?.name ?? id;
const src = member?.avatar ? `https://sleepercdn.com/avatars/thumbs/${member.avatar}` : null;
---
{avatar && src ? (
  <a class={`mlink ${size === 'lg' ? 'lg' : ''}`} href={`${base}/member/${id}/`}>
    <img src={src} alt="" width={size === 'lg' ? 38 : 21} height={size === 'lg' ? 38 : 21} loading="lazy" />
    <span>{name}</span>
  </a>
) : (
  <a href={`${base}/member/${id}/`}>{name}</a>
)}
